# ============================================================
# Mailman 环境配置（用于 docker-compose）
# 复制此文件为 .env 并根据需要修改
# ============================================================

# PostgreSQL 数据库配置
POSTGRES_DB=mailman
POSTGRES_USER=mailman
POSTGRES_PASSWORD=your_password_here

# Mailman 服务端口（宿主机映射端口）
MAILMAN_PORT=8080

# 敏感数据加密密钥 (base64编码的32字节密钥)
# 生产环境建议配置，用于加密 API Key、密码等
# 生成方法: openssl rand -base64 32
# ENCRYPTION_KEY=

# OAuth2 回调地址（如需使用 Gmail/Outlook OAuth2 登录）
# GMAIL_REDIRECT_URI=http://localhost:8080/api/oauth2/callback/gmail
# OUTLOOK_REDIRECT_URI=http://localhost:8080/api/oauth2/callback/outlook