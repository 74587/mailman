# ============================================================
# Mailman All-in-One Docker Image
# ============================================================
# 三阶段构建:
#   1. frontend-builder: 编译前端静态资源 (npm run build → out/)
#   2. backend-builder:  编译后端 Go 二进制
#   3. runtime:          最小运行时镜像 (alpine)
#
# 后端内置 SPA 静态文件服务器，无需 nginx / supervisor / Node.js
# 最终镜像仅暴露 8080 端口
# ============================================================

# ----------------------------------------------------------
# Stage 1: Build frontend static assets
# ----------------------------------------------------------
FROM node:18-alpine AS frontend-builder

WORKDIR /build/frontend

# Install dependencies first (cache layer)
COPY frontend/package.json frontend/package-lock.json ./
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN npm ci --prefer-offline

# Copy source and build
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build

# ----------------------------------------------------------
# Stage 2: Build backend binary
# ----------------------------------------------------------
FROM golang:1.23-alpine AS backend-builder

# Install build dependencies (CGO needed for SQLite driver)
RUN apk add --no-cache git gcc musl-dev build-base binutils-gold

WORKDIR /build/backend

# Download Go dependencies first (cache layer)
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy source and build
COPY backend/ ./
RUN CGO_ENABLED=1 GOOS=linux go build \
    -a -ldflags '-w -s' \
    -o mailman ./cmd/mailman

# ----------------------------------------------------------
# Stage 3: Minimal runtime image
# ----------------------------------------------------------
FROM alpine

# Install minimal runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 -S mailman && \
    adduser -u 1000 -S mailman -G mailman

# Create application directory structure
# Backend SPA handler looks for frontend at ../frontend/out (relative to working dir)
# Working dir = /app/backend → frontend at /app/frontend/out
RUN mkdir -p /app/backend /app/frontend/out /app/data

# Copy backend binary
COPY --from=backend-builder /build/backend/mailman /app/backend/mailman

# Copy frontend static assets
COPY --from=frontend-builder /build/frontend/out /app/frontend/out

# Set ownership
RUN chown -R mailman:mailman /app

# Switch to non-root user
USER mailman

# Working directory must be /app/backend so SPA handler finds ../frontend/out
WORKDIR /app/backend

# Expose backend port
EXPOSE 8080

# Default environment variables (can be overridden at runtime)
ENV SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8080 \
    DB_DRIVER=sqlite \
    DB_NAME=/app/data/mailman.db

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/api/health || exit 1

# Run the backend binary (serves both API and frontend)
CMD ["./mailman"]